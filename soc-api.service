[Unit]
Description=SENTINELOPS API Service
After=network.target

[Service]
Type=simple
User=jenishkali
WorkingDirectory=/home/jenishkali/Desktop/SENTINELOPS
Environment="PATH=/home/jenishkali/Desktop/SENTINELOPS/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/jenishkali/Desktop/SENTINELOPS/venv/bin/uvicorn src.api:app --host 0.0.0.0 --port 8001
ExecStop=/usr/bin/pkill -f "uvicorn src.api"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
